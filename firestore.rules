rules_version = '2';

// CheapTripChip Firestore rules: every user's data lives under
// users/{uid}/... and only that user may read or write it. Guest (signed-out)
// data never touches Firestore — it stays local (see lib/data/local_repositories.dart).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
